# Replace @INSTALL_ROOT@ with the absolute installed checkout path.
[Unit]
Description=Polstation diagnostic hardware-preview dashboard
After=local-fs.target
PartOf=polstation-preview.target polstation-recording.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=polstation
Group=polstation
WorkingDirectory=@INSTALL_ROOT@
ExecStart=@INSTALL_ROOT@/.venv/bin/polstation-dashboard --config /etc/polstation/config.yaml --hardware-preview
Restart=always
RestartSec=10
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/polstation
PrivateDevices=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=polstation-preview.target polstation-recording.target
